# Copy this file to .env.local for local development, and add the same
# values in your hosting provider's dashboard (e.g. Vercel → Project →
# Settings → Environment Variables) for production.
#
# Every variable here is OPTIONAL. The site works without any of them —
# the quote form will still validate and log submissions server-side, and
# analytics stays off. Add them when you're ready to go live.

# ---- Lead delivery (Resend) -------------------------------------------
# Get a free API key at https://resend.com after signing up.
# Without this set, quote form submissions are logged on the server but
# NOT emailed anywhere — see README.md "Connect the lead form."
RESEND_API_KEY=

# Must be an email address on a domain you've verified with Resend.
# Leave unset to use Resend's shared test sender (onboarding@resend.dev),
# which works for testing but looks less trustworthy to recipients and
# has sending limits — verify your own domain before real launch.
RESEND_FROM_EMAIL=

# Where quote requests get emailed. Defaults to the business email in
# lib/config.ts if not set.
LEAD_RECIPIENT_EMAIL=

# ---- Analytics (optional) ----------------------------------------------
# Google Analytics 4 Measurement ID (starts with "G-"). Leave blank to
# keep analytics off entirely — no script loads, no cookies set.
NEXT_PUBLIC_GA_ID=
